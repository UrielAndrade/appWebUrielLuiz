@page "/processos"
@using AppWebUriel.Model
@using AppWebUriel.DAO
@inject ProcessoDAO ProcessoDAO

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Consulta de Processos</h2>
    </div>
</div>

<!--Botao de cadastro de processo-->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
    </div>
    <div>
        <a href="/processos/cadastro" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Processo
        </a>
    </div>
</div>

<div class="custom-table-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (processos == null || processos.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">Nenhum processo encontrado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var processo in processos)
                    {
                        <tr>
                            <td>@processo.Id</td>
                            <td>@processo.Numero</td>
                            <td>@processo.Interessado</td>
                            <td>@processo.Assunto</td>
                            <td>@processo.Situacao</td>
                            <td>
                                <button class="btn btn-primary btn-sm me-1">Editar</button>
                                <button class="btn btn-danger btn-sm">Excluir</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Processo> processos = new();

    protected override void OnInitialized()
    {
        try
        {
            // Chama o DAO para buscar os dados no banco
            processos = ProcessoDAO.Listar();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar processos: {ex.Message}");
        }
    }
}